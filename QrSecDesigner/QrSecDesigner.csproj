<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QrSecDesigner</RootNamespace>
    <AssemblyName>QrSecDesigner</AssemblyName>
    <AssemblyTitle>QrSec Designer - pembuat QR + secret</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\qrsec\qrsec.csproj" />
    <!-- dipakai hanya untuk membaca ulang QR hasil (verifikasi), bukan untuk membuatnya -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
